# =============================================================================
# API Keys — copie para .env e preencha
# Nunca faça commit do .env
# =============================================================================

# Obrigatórias para Week 1-2
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Opcional mas recomendada
GOOGLE_API_KEY=...

# HuggingFace — necessária a partir de Week 3
# Crie em: https://huggingface.co/settings/tokens
# Permissão: WRITE (não Fine-grained)
HF_TOKEN=hf_...

# Week 2 — notificações push (opcional)
PUSHOVER_USER=...
PUSHOVER_TOKEN=...
